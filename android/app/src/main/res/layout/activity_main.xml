<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WiFiTrustFusion"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Experimental Wi-Fi Evidence Collector"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="M2.6 SESSION COLLECTOR&#10;&#10;Repeated acquisition is active. Persistent export and risk scoring are not active."
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonRequestPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Grant Wi-Fi Scan Permission" />

        <Button
            android:id="@+id/buttonLocationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open Location Settings" />

        <Button
            android:id="@+id/buttonRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh Diagnostics" />

        <Button
            android:id="@+id/buttonRunSingleScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Run Manual Single Scan" />

        <Button
            android:id="@+id/buttonStartSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start Development Session" />

        <Button
            android:id="@+id/buttonStopSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop Session" />

        <TextView
            android:id="@+id/textDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="SESSION IDLE"
            android:textIsSelectable="true"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textScanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Collector status: idle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textScanResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="No scan has been requested."
            android:textIsSelectable="true"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
